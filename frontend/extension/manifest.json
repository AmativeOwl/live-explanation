{
  "manifest_version": 3,
  "name": "Live Explanation",
  "version": "1.0.0",
  "description": "Real-time explanation for browser video content",
  "action": {
    "default_title": "Live Explanation",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["dist/content_script.js"]
    }
  ],
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["http://localhost:8000/*"],
  "web_accessible_resources": [{
    "resources": ["audio_processor.js", "dist/content_script.js"],
    "matches": ["<all_urls>"]
  }]
}